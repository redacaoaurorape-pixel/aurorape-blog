# Copie este arquivo para .env e preencha os valores
DATABASE_URL=postgresql+asyncpg://usuario:senha@localhost:5432/aurorape
SECRET_KEY=troque-por-uma-chave-secreta-longa-e-aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DEBUG=True
SITE_NAME=Aurora PE
SITE_URL=https://aurorape.com.br
CORS_ORIGINS=http://localhost:3000,https://aurorape.vercel.app
MOCK_MODE=False

# Storage de imagens compatível com S3 (Railway Buckets / Tigris / AWS S3 / MinIO)
# No Railway CLI: configure com `railway variables set BUCKET_ENDPOINT_URL=...`
BUCKET_ENDPOINT_URL=
BUCKET_NAME=
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=
BUCKET_REGION=auto
BUCKET_PUBLIC_URL_BASE=
