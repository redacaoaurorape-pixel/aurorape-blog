# Copie este arquivo para .env.local e preencha os valores conforme necessário

# URL da API do backend — usada em Server Components / Server Actions (lado servidor)
API_URL=http://localhost:8000/api/v1

# URL da API do backend — usada no browser (lado cliente). Precisa do prefixo NEXT_PUBLIC_
# para ficar disponível no bundle do client.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# --- Google AdSense (opcional) ---
# Sem essas variáveis, os espaços de anúncio continuam mostrando o placeholder
# visual tracejado ("Publicidade", com o tamanho do espaço) — nada quebra e
# nenhum script externo é carregado. Preencha todas quando a conta AdSense for
# aprovada para ativar os anúncios reais.

# ID do publisher, no formato "ca-pub-XXXXXXXXXXXXXXXX"
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Slot da unidade de anúncio 300×250 na lateral da página de matéria
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_SIDEBAR_MEDIUM=

# Slot da unidade de anúncio 300×600 na lateral da página de matéria
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_SIDEBAR_LARGE=

# Slot do anúncio inline (728×90 desktop / responsivo mobile) entre a grade de
# destaques e a lista de últimas notícias, na home
NEXT_PUBLIC_ADSENSE_SLOT_HOME_INLINE_TOP=

# Slot do anúncio inline (728×90 desktop / responsivo mobile) entre a seção
# institucional e o formulário de newsletter, na home
NEXT_PUBLIC_ADSENSE_SLOT_HOME_INLINE_BOTTOM=
